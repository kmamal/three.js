{
  "name": "@kmamal/three",
  "version": "0.1.0",
  "description": "Fork of three.js that can render to windows",
  "type": "module",
  "main": "./src/Three.js",
  "module": "./src/Three.js",
  "exports": {
    ".": "./src/Three.js",
    "./examples/fonts/*": "./examples/fonts/*",
    "./examples/jsm/*": "./examples/jsm/*",
    "./addons": "./examples/jsm/Addons.js",
    "./addons/*": "./examples/jsm/*",
    "./src/*": "./src/*",
    "./webgpu": "./src/Three.WebGPU.js",
    "./tsl": "./src/Three.TSL.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kmamal/three.js"
  },
  "sideEffects": [
    "./src/nodes/**/*"
  ],
  "files": [
    "examples/jsm",
    "LICENSE",
    "package.json",
    "src",
    "README.md"
  ],
  "directories": {
    "example": "examples",
    "test": "test"
  },
  "scripts": {
    "test": "npm run lint && npm run test-unit && npm run test-unit-addons && npm run test-platform",
    "lint-core": "eslint src",
    "lint-addons": "eslint examples/jsm",
    "lint-examples": "eslint examples",
    "lint-editor": "eslint editor",
    "lint-test": "eslint test",
    "lint-utils": "eslint utils",
    "lint": "npm run lint-core",
    "lint-fix": "npm run lint-core -- --fix && npm run lint-addons -- --fix && npm run lint-examples -- --fix && npm run lint-editor -- --fix && npm run lint-test -- --fix && npm run lint-utils -- --fix",
    "test-unit": "qunit --require ./test/unit/setup.mjs test/unit/three.source.unit.js",
    "test-unit-addons": "qunit --require ./test/unit/setup.mjs test/unit/three.addons.node.unit.js",
    "test-e2e": "node test/e2e/run.js",
    "test-e2e-cov": "node test/e2e/check-coverage.js",
    "test-e2e-webgpu": "node test/e2e/run.js --webgpu",
    "make-tsl-reference": "node test/unit/tsl/make.js",
    "port-examples": "node utils/port-examples.js",
    "port-examples-check": "node utils/port-examples.js --check",
    "test-platform": "node --test --test-timeout=60000 test/platform/unit",
    "test-platform-window": "node --test --test-timeout=120000 --test-concurrency=1 test/platform/window",
    "test-unit-gpu": "qunit --require ./test/unit/setup.mjs test/unit/three.addons.gpu.unit.js"
  },
  "keywords": [
    "@kmamal/three",
    "three.js",
    "javascript",
    "3d",
    "virtual-reality",
    "augmented-reality",
    "webgl",
    "webgl2",
    "webaudio",
    "webgpu",
    "webxr"
  ],
  "author": "mrdoob",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kmamal/three.js/issues"
  },
  "homepage": "https://github.com/kmamal/three.js#README.md",
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.17.3",
    "@eslint/js": "^9.0.0",
    "@gsimone/three-raycaster-helper": "0.1.0",
    "@jgphilpott/polyslice": "26.4.0",
    "@needle-tools/gltf-progressive": "3.2.0",
    "@needle-tools/three-animation-pointer": "1.0.7",
    "@perplexdotgg/bounce": "1.8.1",
    "@takram/three-atmosphere": "0.19.1",
    "@takram/three-clouds": "0.7.6",
    "@takram/three-geospatial": "0.9.1",
    "@takram/three-geospatial-effects": "0.6.4",
    "@three.ez/batched-mesh-extensions": "0.0.11",
    "@three.ez/simplify-geometry": "0.0.1",
    "3d-tiles-renderer": "0.4.27",
    "bvh.js": "0.0.13",
    "eslint": "^10.8.0",
    "eslint-config-mdcs": "^5.0.0",
    "eslint-plugin-compat": "^7.0.0",
    "eslint-plugin-jsdoc": "^64.0.0",
    "globals": "^17.0.0",
    "jolt-physics": "1.0.0",
    "jpeg-js": "^0.4.4",
    "lottie-web": "5.13.0",
    "meshoptimizer": "1.1.1",
    "monomorph": "2.3.1",
    "mp4box": "2.3.0",
    "opentype.js": "1.3.4",
    "pngjs": "^7.0.0",
    "postprocessing": "6.39.1",
    "qunit": "3.0.0",
    "rhino3dm": "8.32.1",
    "three": "file:utils/three-alias",
    "three-bvh-csg": "0.0.18",
    "three-good-godrays": "0.12.0",
    "three-gpu-pathtracer": "0.0.26",
    "three-html-render": "0.1.2",
    "three-mesh-bvh": "0.9.15",
    "three-subdivide": "1.1.5",
    "web-ifc": "0.0.77"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@xmldom/xmldom": "0.9.12",
    "css-select": "7.0.0",
    "cssom": "0.5.0",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "peerDependencies": {
    "@dimforge/rapier3d-compat": "0.17.3",
    "@kmamal/audio": ">=0.0.0",
    "@kmamal/gl": ">=10.0.0-1",
    "@kmamal/gpu": ">=1.0.0-4",
    "@kmamal/sdl": ">=1.0.0-3",
    "jolt-physics": "1.0.0",
    "mp4box": "2.3.0",
    "opentype.js": "1.3.4"
  },
  "peerDependenciesMeta": {
    "@dimforge/rapier3d-compat": {
      "optional": true
    },
    "@kmamal/audio": {
      "optional": true
    },
    "@kmamal/gl": {
      "optional": true
    },
    "@kmamal/gpu": {
      "optional": true
    },
    "@kmamal/sdl": {
      "optional": true
    },
    "jolt-physics": {
      "optional": true
    },
    "mp4box": {
      "optional": true
    },
    "opentype.js": {
      "optional": true
    }
  }
}
