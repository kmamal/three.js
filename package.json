{
  "name": "@kmamal/three",
  "version": "0.1.0",
  "description": "Fork of three.js that can render to windows",
  "type": "module",
  "main": "./src/Three.js",
  "module": "./src/Three.js",
  "exports": {
    ".": "./src/Three.js",
    "./examples/fonts/*": "./examples/fonts/*",
    "./examples/jsm/*": "./examples/jsm/*",
    "./addons": "./examples/jsm/Addons.js",
    "./addons/*": "./examples/jsm/*",
    "./src/*": "./src/*",
    "./webgpu": "./src/Three.WebGPU.js",
    "./tsl": "./src/Three.TSL.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kmamal/three.js"
  },
  "sideEffects": [
    "./src/nodes/**/*"
  ],
  "files": [
    "examples/jsm",
    "LICENSE",
    "package.json",
    "src",
    "README.md"
  ],
  "directories": {
    "example": "examples",
    "test": "test"
  },
  "browserslist": [
    "> 1%, not dead, not ie 11, not op_mini all"
  ],
  "scripts": {
    "test": "npm run lint && npm run test-unit && npm run test-unit-addons",
    "lint-core": "eslint src",
    "lint-addons": "eslint examples/jsm",
    "lint-examples": "eslint examples",
    "lint-editor": "eslint editor",
    "lint-test": "eslint test",
    "lint-utils": "eslint utils",
    "lint": "npm run lint-core",
    "lint-fix": "npm run lint-core -- --fix && npm run lint-addons -- --fix && npm run lint-examples -- --fix && npm run lint-editor -- --fix && npm run lint-test -- --fix && npm run lint-utils -- --fix",
    "test-unit": "node test/unit/puppeteer.unit.js --testPage=UnitTests.html --mode=headless",
    "benchmark-proxy-node-material": "node test/benchmarks/proxy-node-material.js",
    "test-unit-headful": "node test/unit/puppeteer.unit.js --testPage=UnitTests.html --mode=headful",
    "test-unit-addons": "node test/unit/puppeteer.unit.js --testPage=UnitTestsAddons.html --mode=headless",
    "test-unit-addons-headful": "node test/unit/puppeteer.unit.js --testPage=UnitTestsAddons.html --mode=headful",
    "test-e2e": "node test/e2e/puppeteer.js",
    "test-e2e-cov": "node test/e2e/check-coverage.js",
    "test-e2e-webgpu": "node test/e2e/puppeteer.js --webgpu",
    "make-screenshot": "node test/e2e/puppeteer.js --make",
    "make-tsl-reference": "node test/unit/tsl/make.js"
  },
  "keywords": [
    "@kmamal/three",
    "three.js",
    "javascript",
    "3d",
    "virtual-reality",
    "augmented-reality",
    "webgl",
    "webgl2",
    "webaudio",
    "webgpu",
    "webxr"
  ],
  "author": "mrdoob",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kmamal/three.js/issues"
  },
  "homepage": "https://github.com/kmamal/three.js#README.md",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^10.8.0",
    "eslint-config-mdcs": "^5.0.0",
    "eslint-plugin-compat": "^7.0.0",
    "eslint-plugin-html": "^8.1.3",
    "eslint-plugin-jsdoc": "^64.0.0",
    "globals": "^17.0.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.0.0",
    "three": "file:utils/three-alias"
  },
  "allowScripts": {
    "puppeteer": true,
    "fsevents": true
  }
}
